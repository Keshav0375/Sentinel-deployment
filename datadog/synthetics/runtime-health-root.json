{
  "name": "sentinel-runtime-health GET /",
  "type": "api",
  "subtype": "http",
  "status": "live",
  "config": {
    "request": {
      "method": "GET",
      "url": "__APP_URL__/",
      "timeout": 60
    },
    "assertions": [
      {
        "type": "statusCode",
        "operator": "is",
        "target": 200
      },
      {
        "type": "header",
        "property": "content-type",
        "operator": "contains",
        "target": "application/json"
      },
      {
        "type": "body",
        "operator": "validatesJSONPath",
        "target": {
          "jsonPath": "$.message",
          "operator": "is",
          "elementsOperator": "firstElementMatches",
          "targetValue": "ok"
        }
      }
    ]
  },
  "locations": [
    "aws:ca-central-1"
  ],
  "options": {
    "tick_every": 1800,
    "min_failure_duration": 0,
    "retry": {
      "count": 1,
      "interval": 60000
    },
    "min_location_failed": 1,
    "monitor_options": {
      "renotify_interval": 0
    }
  },
  "message": "sentinel-watchtower GET / failed a check (status 200, content-type application/json, $.message == ok) twice, a minute apart (case iii, signal_type runtime_error): the version that passed verify is broken at runtime.\n{{#is_alert}}@webhook-sentinel-event-grid{{/is_alert}}",
  "tags": [
    "service:sentinel-watchtower",
    "env:dev"
  ]
}
